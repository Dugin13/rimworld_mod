<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<ThingDef ParentName="LancerMechanoidWalker">
		<defName>Mech_LancerAssault</defName>
		<label>assault lancer</label>
		<description>A lancer-pattern mechanoid reconfigured around an assault rifle. It trades some of the vanilla lancer's reach for steadier mid-range fire.</description>
	</ThingDef>

	<ThingDef ParentName="LancerMechanoidWalker">
		<defName>Mech_LancerSniper</defName>
		<label>sniper lancer</label>
		<description>A lancer-pattern mechanoid tuned for precision fire with a sniper rifle. It is dangerous at long range but less efficient once targets close in.</description>
	</ThingDef>

	<ThingDef ParentName="LancerMechanoidWalker">
		<defName>Mech_LancerCharge</defName>
		<label>charge lancer</label>
		<description>A lancer-pattern mechanoid fitted with a charge rifle. It is more aggressive than a standard lancer and excels at sustained medium-range fire.</description>
	</ThingDef>

